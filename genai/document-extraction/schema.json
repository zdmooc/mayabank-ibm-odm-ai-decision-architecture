{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayainsurance.example/schemas/document-extraction-v1.json",
  "title": "MayaInsuranceDocumentExtractionV1",
  "type": "object",
  "required": [
    "documentId",
    "documentType",
    "claimId",
    "lossDate",
    "claimedAmount",
    "currency",
    "confidenceScore",
    "providerStatus",
    "extractionVersion"
  ],
  "properties": {
    "documentId": {"type": "string", "minLength": 1},
    "documentType": {"type": "string", "enum": ["CLAIM_NOTICE", "INVOICE", "SUPPORTING_DOCUMENT"]},
    "claimId": {"type": "string", "minLength": 1},
    "lossDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "claimedAmount": {"type": "number", "minimum": 0},
    "currency": {"type": "string", "enum": ["EUR"]},
    "confidenceScore": {"type": "number", "minimum": 0, "maximum": 1},
    "providerStatus": {"type": "string", "enum": ["AVAILABLE", "UNAVAILABLE"]},
    "extractionVersion": {"type": "string", "const": "genai-extraction-v1"}
  },
  "additionalProperties": false
}
